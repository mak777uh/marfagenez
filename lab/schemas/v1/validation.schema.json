{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab/schemas/v1/validation.schema.json",
  "title": "Запись валидации validation/v1",
  "description": "Результат работы validation runner по зарегистрированному профилю из trusted gate tree. Содержит recommendation, но не решение: Decision принимает main. N/A не считается зелёным; пропуск проверки обязан быть явным и видимым. Если candidate diff затрагивает protected gate/build-файлы, добавляется escalate_to_main и авто-зелёный невозможен.",
  "type": "object",
  "required": [
    "schema", "id", "submission_id", "bundle_sha256",
    "validator_profile", "validator_version",
    "gate_script_sha256", "sandbox_image_digest",
    "toolchain", "checks",
    "recommendation", "reason",
    "started_at", "finished_at", "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "validation/v1" },
    "id": { "type": "string", "minLength": 1, "pattern": "^VAL-" },
    "submission_id": { "type": "string", "minLength": 1 },
    "bundle_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "validator_profile": { "type": "string", "minLength": 1 },
    "validator_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "gate_script_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "sandbox_image_digest": { "type": "string", "minLength": 1 },
    "toolchain": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "python": { "type": "string" },
        "rust": { "type": "string" },
        "lean": { "type": "string" }
      }
    },
    "network_log_artifact": {
      "type": "string",
      "description": "Артефакт сетевой активности (пусто/none при network_profile=none)."
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "rc"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "rc": { "type": "integer" },
          "skipped_reason": {
            "type": "string",
            "description": "Явное обоснование пропуска. Пропуск без причины не допускается."
          },
          "evidence": { "type": "string" }
        }
      }
    },
    "escalate_to_main": {
      "type": "boolean",
      "default": false,
      "description": "true, если candidate diff затронул trusted gate/build-файлы. Валидация не даёт авто-зелёный."
    },
    "recommendation": { "$ref": "common.schema.json#/$defs/recommendation" },
    "reason": { "type": "string", "minLength": 1 },
    "started_at": { "$ref": "common.schema.json#/$defs/rfc3339" },
    "finished_at": { "$ref": "common.schema.json#/$defs/rfc3339" },
    "logs_artifact": { "type": "string" },
    "created_at": { "$ref": "common.schema.json#/$defs/rfc3339" }
  }
}
