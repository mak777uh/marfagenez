{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marfagenez/litsearch-v1.schema.json",
  "title": "Litsearch run snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "created_at",
    "environment",
    "query",
    "channels",
    "dedup",
    "fusion",
    "degraded",
    "works"
  ],
  "properties": {
    "schema": {
      "const": "litsearch/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z_[0-9a-f]{6}$"
    },
    "created_at": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_commit",
        "side",
        "tool_versions"
      ],
      "properties": {
        "repo_commit": {
          "type": "string"
        },
        "side": {
          "enum": [
            "windows",
            "wsl"
          ]
        },
        "tool_versions": {
          "type": "object"
        },
        "semantic_model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "lang",
        "seeds",
        "fingerprint"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 3
        },
        "lang": {
          "type": "string"
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,64}$"
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "elapsed_ms",
          "params",
          "results"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "ok",
              "empty",
              "error",
              "skipped_budget"
            ]
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0
          },
          "cost_usd_est": {
            "type": [
              "number",
              "null"
            ]
          },
          "params": {
            "type": "object"
          },
          "raw_snapshot": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rank",
                "ids",
                "title"
              ],
              "properties": {
                "rank": {
                  "type": "integer",
                  "minimum": 1
                },
                "ids": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "doi": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "arxiv": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "openalex": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "pmid": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "title": {
                  "type": "string"
                },
                "year": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "score_raw": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "score_kind": {
                  "enum": [
                    "bm25",
                    "cosine",
                    "api",
                    null
                  ]
                }
              }
            }
          }
        }
      }
    },
    "dedup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "clusters"
      ],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^doi>arxiv>pmid>title_norm\\+year(; same title\\+year merged)?$"
        },
        "clusters": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "fusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "k",
        "weights",
        "tie_break",
        "ranking"
      ],
      "properties": {
        "method": {
          "const": "rrf"
        },
        "k": {
          "const": 60
        },
        "weights": {
          "type": "object"
        },
        "tie_break": {
          "const": "score_desc_key_asc"
        },
        "ranking": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "rrf",
              "ranks",
              "channels"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "rrf": {
                "type": "number"
              },
              "ranks": {
                "type": "object"
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "degraded": {
      "type": "boolean"
    },
    "saturation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "prev_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "new_unique": {
          "type": [
            "integer",
            "null"
          ]
        },
        "new_frac_top20": {
          "type": [
            "number",
            "null"
          ]
        },
        "jaccard_top20": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "key",
          "title"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "arxiv": {
            "type": [
              "string",
              "null"
            ]
          },
          "openalex": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
